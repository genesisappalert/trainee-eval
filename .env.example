# ============================================================
# MTP Appraisal Platform — Environment Variables Template
# Copy this file to .env.local and populate with your credentials
# ============================================================

# Database Configuration
# MongoDB connection string (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/mtp_appraisal

# Authentication (NextAuth.js v5)
# Generate a secure 32+ character key (e.g. openssl rand -base64 32)
AUTH_SECRET=your_nextauth_secret_key_minimum_32_characters

# Canonical Application Base URL
NEXTAUTH_URL=http://localhost:3000

# Application Environment (development | production | test)
NODE_ENV=development

# Optional: Email Service (Resend)
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM_EMAIL=notifications@genesisgroupng.com
